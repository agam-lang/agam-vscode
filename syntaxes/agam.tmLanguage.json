{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Agam",
  "scopeName": "source.agam",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#decorators" },
    { "include": "#keywords" },
    { "include": "#effects" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#functions" },
    { "include": "#operators" },
    { "include": "#numbers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.agam",
          "match": "//.*$"
        },
        {
          "name": "comment.block.agam",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.agam",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.agam",
              "match": "\\\\([nrt\\\\\"'0]|x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F]+\\})"
            },
            {
              "name": "punctuation.definition.template-expression.agam",
              "begin": "\\$\\{",
              "end": "\\}",
              "patterns": [{ "include": "$self" }]
            }
          ]
        },
        {
          "name": "string.quoted.single.agam",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.agam",
              "match": "\\\\([nrt\\\\\"'0]|x[0-9a-fA-F]{2})"
            }
          ]
        }
      ]
    },
    "decorators": {
      "patterns": [
        {
          "name": "entity.name.function.decorator.agam",
          "match": "@(gpu|accelerate|target\\.(hpc|enterprise|iot)|trace|metric|contract|comptime|derive|ui|kernel)\\b"
        },
        {
          "name": "entity.name.function.decorator.custom.agam",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*(\\.[a-zA-Z_][a-zA-Z0-9_]*)*"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.agam",
          "match": "\\b(if|else|match|for|in|while|loop|break|continue|return|yield|spawn|await|async)\\b"
        },
        {
          "name": "keyword.declaration.agam",
          "match": "\\b(fn|let|mut|const|struct|enum|trait|impl|type|effect|handler|perform|import|pub|use|mod)\\b"
        },
        {
          "name": "keyword.other.sandhi.agam",
          "match": "\\b(sandhi|nyaya|durdharsha|kosha)\\b"
        }
      ]
    },
    "effects": {
      "patterns": [
        {
          "name": "keyword.control.effect.agam",
          "match": "\\b(perform|handle|resume|pure)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.primitive.agam",
          "match": "\\b(i8|i16|i32|i64|i128|i256|i512|isize|u8|u16|u32|u64|u128|u256|u512|usize|f32|f64|bool|char|str|String|void|Self|Tensor|Option|Result|Vec|Map|Set)\\b"
        },
        {
          "name": "entity.name.type.user-defined.agam",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.agam",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.agam",
          "match": "\\b(None|Some|Ok|Err)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.agam" },
            "2": { "name": "entity.name.function.agam" }
          }
        },
        {
          "name": "entity.name.function.call.agam",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.agam",
          "match": "(\\+|\\-|\\*|\\/|%|\\*\\*)"
        },
        {
          "name": "keyword.operator.comparison.agam",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.agam",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.assignment.agam",
          "match": "(=|\\+=|\\-=|\\*=|\\/=|%=)"
        },
        {
          "name": "keyword.operator.arrow.agam",
          "match": "(->|=>)"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.agam",
          "match": "\\b0x[0-9a-fA-F_]+([ui](8|16|32|64|128|256|512|size))?\\b"
        },
        {
          "name": "constant.numeric.binary.agam",
          "match": "\\b0b[01_]+([ui](8|16|32|64|128|256|512|size))?\\b"
        },
        {
          "name": "constant.numeric.float.agam",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9_]+)?(f32|f64)?\\b"
        },
        {
          "name": "constant.numeric.integer.agam",
          "match": "\\b[0-9][0-9_]*([ui](8|16|32|64|128|256|512|size))?\\b"
        }
      ]
    }
  }
}
